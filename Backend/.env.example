DB_HOST=localhost
DB_PORT=3306
DB_NAME=juvcare_db
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_local_mysql_password
# Set a cryptographically random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRE_MINUTES=30

# Google OIDC: obtain these from your own Google Cloud Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# False ONLY for local HTTP development. Use true with HTTPS in production.
GOOGLE_COOKIE_SECURE=false

# Optional: at least 32 random characters; otherwise a key is derived from JWT_SECRET.
PASSWORD_RECOVERY_SECRET=
